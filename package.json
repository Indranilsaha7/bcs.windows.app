{
    "name": "bcs-enterprise-pos",
    "version": "1.9.5",
    "description": "BCS Enterprise POS PRO Max",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win",
        "release": "electron-builder --win --publish always"
    },
    "dependencies": {
        "acorn": "^8.19.0",
        "electron": "^31.3.1"
    },
    "devDependencies": {
        "electron-builder": "^26.15.3",
        "electron-updater": "^6.8.9"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Indranilsaha7/bcs.windows.app"
    },
    "build": {
        "appId": "com.bcsdeveloper.pos",
        "productName": "BCS Enterprise POS PRO Max",
        "copyright": "Copyright © 2026 Baroda Computer And Sales. All rights reserved.",
        "directories": {
            "output": "dist",
            "buildResources": "assets"
        },
        "files": [
            "**/*",
            "!backend/**",
            "!*.md",
            "!.github/**"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "assets/icon.ico",
            "publisherName": "Baroda Computer And Sales",
            "legalTrademarks": "BCS Enterprise POS is a trademark of Baroda Computer And Sales",
            "requestedExecutionLevel": "asInvoker",
            "verifyUpdateCodeSignature": false,
            "rfc3161TimeStampServer": "http://timestamp.digicert.com"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "BCS Enterprise POS",
            "uninstallDisplayName": "BCS Enterprise POS",
            "runAfterFinish": true,
            "differentialPackage": false
        },
        "publish": [
            {
                "provider": "github",
                "owner": "Indranilsaha7",
                "repo": "bcs.windows.app"
            }
        ]
    }
}
