<ui:FluentWindow x:Class="BcsPosApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BcsPosApp"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Baroda Computer &amp; Sales - Login" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="al.ico"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ResizeMode="NoResize">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Baroda Computer &amp; Sales" Background="#44000000" HorizontalAlignment="Stretch" Padding="10,5">
            <ui:TitleBar.Icon>
                <!-- Use PNG for UI to prevent layout stretching, keep ICO for Window -->
                <ui:ImageIcon Source="al.png" Width="18" Height="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <!-- Background Image with slight opacity so Mica shines through -->
            <Image Source="bg-walpaper.png" Stretch="UniformToFill" Opacity="0.30" />
            
            <!-- Login Card -->
            <Border Background="#550f172a" 
                    CornerRadius="12" 
                    BorderBrush="#33ffffff" 
                    BorderThickness="1" 
                    Width="400" Height="580"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="Black"/>
                </Border.Effect>

                <StackPanel Margin="40" VerticalAlignment="Center">
                    
                    <!-- Logo -->
                    <Image Source="al.png" Width="100" Height="100" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Welcome Back" 
                               Foreground="White" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,5"/>
                    
                    <TextBlock Text="Login to your POS account" 
                               Foreground="#94a3b8" 
                               FontSize="14" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,30"/>
                    
                    <!-- Username using Wpf.Ui controls -->
                    <TextBlock Text="Username or Email" Foreground="#cbd5e1" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <ui:TextBox x:Name="txtUsername" PlaceholderText="Enter username..." Margin="0,0,0,15" Padding="10" />
                    
                    <!-- Password using Wpf.Ui controls -->
                    <TextBlock Text="Password" Foreground="#cbd5e1" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <ui:PasswordBox x:Name="txtPassword" PlaceholderText="Enter password..." Margin="0,0,0,15" Padding="10" />
                    
                    <!-- Security Code -->
                    <TextBlock Text="Security Code" Foreground="#cbd5e1" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <ui:PasswordBox x:Name="txtCode" PlaceholderText="Enter security code..." Margin="0,0,0,25" Padding="10" />
                    
                    <!-- Login Button with Smart Enter Key -->
                    <ui:Button Content="Sign In" IsDefault="True" Appearance="Primary" HorizontalAlignment="Stretch" Padding="0,10" Click="BtnLogin_Click" />
                    
                    <!-- Error Message Placeholder -->
                    <TextBlock x:Name="lblError" 
                               Foreground="#ef4444" 
                               FontSize="13" 
                               Margin="0,15,0,0" 
                               TextWrapping="Wrap" 
                               HorizontalAlignment="Center" 
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
            
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" />
    </Grid>
</ui:FluentWindow>
