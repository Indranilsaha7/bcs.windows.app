<Page x:Class="BarodaPOS.Views.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:viewmodels="clr-namespace:BarodaPOS.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="CalendarPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
      
    <Page.DataContext>
        <viewmodels:CalendarViewModel />
    </Page.DataContext>
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBox Style="{DynamicResource SelectableText}" Grid.Row="0" Text="Interactive Calendar" FontSize="32" FontWeight="Bold" Margin="0,0,0,32" />
        
        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                        PlaceholderText="Search events by title or description..." 
                        Icon="{ui:SymbolIcon Symbol=Search24}"
                        FontSize="16"
                        Padding="12"
                        Margin="0,0,16,0" />

            <ui:Button Grid.Column="1" Content="Refresh" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Appearance="Secondary" Command="{Binding LoadEventsCommand}" Margin="0,0,16,0" Padding="16,8"/>
            <ui:Button Grid.Column="2" Content="Add Event" Icon="{ui:SymbolIcon Symbol=Add24}" Appearance="Primary" Command="{Binding ShowAddEventCommand}" Padding="16,8"/>
        </Grid>
        
        <ui:ProgressRing Grid.Row="2" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40" Margin="0,0,0,16"/>

        <!-- The Priority Calendar View -->
        <Border Grid.Row="3" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBox Grid.Row="0" Style="{DynamicResource SelectableText}" Text="Select a date on the calendar below to view its tasks." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" HorizontalAlignment="Center"/>
                
                <!-- Viewbox with max height/width so it fits properly in the screen without overflowing -->
                <Viewbox Grid.Row="1" Stretch="Uniform" MaxHeight="600" MaxWidth="800">
                    <Calendar SelectedDate="{Binding SelectedFilterDate, Mode=TwoWay}" />
                </Viewbox>
            </Grid>
        </Border>

        <!-- Hidden Agenda / Tasks Overlay (Shows only when a date is selected) -->
        <Grid Grid.RowSpan="4" Background="#90000000" Panel.ZIndex="500">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDateSelected}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            
            <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="12" Width="650" Height="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBox Style="{DynamicResource SelectableText}" Text="Tasks for Selected Date" FontSize="20" FontWeight="Bold" />
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding SelectedFilterDate, StringFormat={}{0:dd MMMM yyyy}}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <!-- Close Button -->
                        <ui:Button Grid.Column="1" Content="Close Tasks" Icon="{ui:SymbolIcon Symbol=Dismiss24}" Appearance="Danger" Command="{Binding ClearDateFilterCommand}" VerticalAlignment="Top" Padding="12,8"/>
                    </Grid>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredEvents}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" RowHeight="48" AlternatingRowBackground="{DynamicResource ControlFillColorSecondaryBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="200" IsReadOnly="True" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                            
                            <DataGridTemplateColumn Header="Action" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}" Appearance="Danger" Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="8"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Add Event Overlay -->
        <Grid Grid.RowSpan="4" Background="#80000000" Panel.ZIndex="1000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAddingEvent}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="12" Padding="24" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBox Style="{DynamicResource SelectableText}" Text="New Calendar Event" FontSize="24" FontWeight="Bold" Margin="0,0,0,24"/>
                    
                    <TextBox Style="{DynamicResource SelectableText}" Text="Date" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding EventDate, Mode=TwoWay}" Margin="0,0,0,16"/>
                    
                    <TextBox Style="{DynamicResource SelectableText}" Text="Title" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding NewEventTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Enter event title..." Margin="0,0,0,16"/>
                    
                    <TextBox Style="{DynamicResource SelectableText}" Text="Description" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding NewEventDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional details..." TextWrapping="Wrap" MinHeight="80" Margin="0,0,0,24"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Cancel" Appearance="Secondary" Command="{Binding CancelAddEventCommand}" HorizontalAlignment="Stretch"/>
                        <ui:Button Grid.Column="2" Content="Save Event" Appearance="Primary" Command="{Binding SaveEventCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
