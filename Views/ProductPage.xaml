<Page x:Class="BarodaPOS.Views.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:viewmodels="clr-namespace:BarodaPOS.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1150"
      Title="ProductPage"
      VerticalAlignment="Stretch"
      HorizontalAlignment="Stretch"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="ProductCardTemplate">
            <Border HorizontalAlignment="Stretch" CornerRadius="14" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" Margin="0,0,16,16" Padding="18" SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- Top Header: Icon, Category/Barcode, Stock Tag -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#143B82F6" BorderBrush="#203B82F6" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Box24" FontSize="22" Foreground="#3B82F6"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Category, TargetNullValue='Hardware', FallbackValue='Hardware', Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Barcode, TargetNullValue='No Barcode Mapped', FallbackValue='No Barcode Mapped', Mode=OneWay}" FontFamily="Consolas, Courier New, Monospace" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Quantity, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Unit, StringFormat=' {0}', Mode=OneWay}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                </StackPanel>
                            </Border>
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding AlertQuantity, StringFormat='Alert: {0}', Mode=OneWay}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Product Name & Brand -->
                    <StackPanel Margin="0,0,0,16" MinHeight="60">
                        <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" FontSize="17" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" MaxHeight="46" ToolTip="{Binding Name}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{DynamicResource SelectableText}" Text="Manufacturer: " FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Brand, TargetNullValue='Unassigned', FallbackValue='Unassigned', Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,14"/>

                    <!-- Price Tiers Display -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBox Style="{DynamicResource SelectableText}" Text="RETAIL SELLING RATE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding DisplaySellPrice, StringFormat='৳ {0:N2}', Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#10B981" />
                            <TextBox Style="{DynamicResource SelectableText}" Text="Customer store rate" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="8,0,14,0"/>

                        <StackPanel Grid.Column="2">
                            <TextBox Style="{DynamicResource SelectableText}" Text="WHOLESALE / DEALER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding DisplayWholesalePrice, StringFormat='৳ {0:N2}', Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding DisplayShopWholesalePrice, StringFormat='Shop: ৳ {0:N2}', Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,14"/>

                    <!-- Actions Footnote Button Bar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Details" Icon="{ui:SymbolIcon Symbol=Eye24}" Appearance="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,8,0" Padding="8,8" ToolTip="View Detailed Specifications &amp; Rates"
                                   Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                        <ui:Button Grid.Column="1" Content="Edit" Icon="{ui:SymbolIcon Symbol=Edit24}" Appearance="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,8,0" Padding="8,8" ToolTip="Edit Specs &amp; Price Tiers"
                                   Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=Delete24}" Appearance="Secondary" Padding="12,8" Foreground="{DynamicResource SystemFillColorCriticalBrush}" ToolTip="Delete SKUs from Catalogue"
                                   Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- Main Content Portal (Full Page Scroll Active) -->
        <ScrollViewer ScrollChanged="MainScrollViewer_ScrollChanged" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Page}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="Both" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Background="Transparent">
            <Grid Margin="32,24,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

            <!-- 1. Executive Title & Quick Actions Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="10" Background="#143B82F6" BorderBrush="#203B82F6" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Archive24" FontSize="22" Foreground="#3B82F6"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBox Style="{DynamicResource SelectableText}" Text="Inventory &amp; Price Master" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBox Style="{DynamicResource SelectableText}" Text="Live catalogue management, wholesale tier pricing, and hardware stock surveillance" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Reload Data" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Appearance="Secondary" Padding="14,9" Command="{Binding LoadDataCommand}" ToolTip="Fetch latest inventory updates from cloud database"/>
                </StackPanel>
            </Grid>

            <!-- 2. Sleek Executive KPI Strip (Replaced bulky toy cards with professional accounting summary bar) -->
            <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Total Catalogue -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8" Fill="#3B82F6" Margin="0,0,8,0"/>
                            <TextBox Style="{DynamicResource SelectableText}" Text="TOTAL CATALOGUE SKUs" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding TotalProducts, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Style="{DynamicResource SelectableText}" Text="items registered" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,0,0,3" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,2"/>

                    <!-- KPI 2: In Stock -->
                    <StackPanel Grid.Column="2" Margin="20,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                            <TextBox Style="{DynamicResource SelectableText}" Text="ACTIVE IN STOCK" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding InStock, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#10B981"/>
                            <TextBox Style="{DynamicResource SelectableText}" Text="available immediately" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,0,0,3" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="3" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,2"/>

                    <!-- KPI 3: Low Stock Alert -->
                    <StackPanel Grid.Column="4" Margin="20,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0"/>
                            <TextBox Style="{DynamicResource SelectableText}" Text="REORDER WARNINGS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding LowStock, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#F59E0B"/>
                            <TextBox Style="{DynamicResource SelectableText}" Text="low threshold reached" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,0,0,3" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="5" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,2"/>

                    <!-- KPI 4: Out of Stock -->
                    <StackPanel Grid.Column="6" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,8,0"/>
                            <TextBox Style="{DynamicResource SelectableText}" Text="DEPLETED INVENTORY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding OutOfStock, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBox Style="{DynamicResource SelectableText}" Text="out of stock" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,0,0,3" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Integrated Search & Advanced Filtration Bar -->
            <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Box -->
                    <ui:TextBox Grid.Column="0" 
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                PlaceholderText="Search inventory by item name, barcode serial, category, or hardware brand..." 
                                Icon="{ui:SymbolIcon Symbol=Search24}"
                                FontSize="14"
                                Padding="12,8"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"/>

                    <!-- Inline Filters & Sort Control -->
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBox Style="{DynamicResource SelectableText}" Text="Sort:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="145" SelectedValue="{Binding SortBy}" SelectedValuePath="Tag" Padding="10,6">
                                <ComboBoxItem Content="Name (A-Z)" Tag="name-asc" />
                                <ComboBoxItem Content="Name (Z-A)" Tag="name-desc" />
                                <ComboBoxItem Content="Price (Low-High)" Tag="price-asc" />
                                <ComboBoxItem Content="Price (High-Low)" Tag="price-desc" />
                                <ComboBoxItem Content="Stock (Low-High)" Tag="qty-asc" />
                                <ComboBoxItem Content="Stock (High-Low)" Tag="qty-desc" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBox Style="{DynamicResource SelectableText}" Text="Status:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="135" SelectedValue="{Binding SelectedStockStatus}" SelectedValuePath="Tag" Padding="10,6">
                                <ComboBoxItem Content="All Stock" Tag="all" />
                                <ComboBoxItem Content="In Stock Only" Tag="in-stock" />
                                <ComboBoxItem Content="Out of Stock" Tag="out-of-stock" />
                                <ComboBoxItem Content="Low Stock Alerts" Tag="alert" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBox Style="{DynamicResource SelectableText}" Text="Category:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="140" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}" Padding="10,6"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBox Style="{DynamicResource SelectableText}" Text="Brand:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="135" ItemsSource="{Binding AvailableBrands}" SelectedItem="{Binding SelectedBrand}" Padding="10,6"/>
                        </StackPanel>

                        <ui:Button Content="Reset" Icon="{ui:SymbolIcon Symbol=FilterDismiss24}" Command="{Binding ClearFiltersCommand}" Appearance="Secondary" Padding="12,7" ToolTip="Reset all filters and search"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Loading Spinner Overlay -->
            <ui:ProgressRing Grid.Row="3" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="48" Height="48" Panel.ZIndex="20"/>

            <!-- Empty State Display -->
            <Border Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoProducts, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="40" CornerRadius="12" Background="Transparent" MaxWidth="440">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Search24" FontSize="32" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBox Style="{DynamicResource SelectableText}" Text="No Matching Inventory Found" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox Style="{DynamicResource SelectableText}" Text="No products match your active filters or search string. Try clearing your search parameters or registering new hardware stock." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <ui:Button Content="Reset All Filters" Icon="{ui:SymbolIcon Symbol=FilterDismiss24}" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Center" Appearance="Primary" Padding="16,8"/>
                </StackPanel>
            </Border>

            <!-- 4. Modern Card-Based Inventory Display (Virtualized) -->
            <ListBox Grid.Row="3" Margin="0,4,-16,24" ItemsSource="{Binding FilteredProductRows}" 
                     Focusable="False" SelectionMode="Single"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLength="2"
                     VirtualizingPanel.CacheLengthUnit="Page">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ContentPresenter Grid.Column="0" Content="{Binding Item1}" ContentTemplate="{StaticResource ProductCardTemplate}" Visibility="{Binding Item1Visibility}"/>
                            <ContentPresenter Grid.Column="1" Content="{Binding Item2}" ContentTemplate="{StaticResource ProductCardTemplate}" Visibility="{Binding Item2Visibility}"/>
                            <ContentPresenter Grid.Column="2" Content="{Binding Item3}" ContentTemplate="{StaticResource ProductCardTemplate}" Visibility="{Binding Item3Visibility}"/>
                            <ContentPresenter Grid.Column="3" Content="{Binding Item4}" ContentTemplate="{StaticResource ProductCardTemplate}" Visibility="{Binding Item4Visibility}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Load More Button -->
            <ui:Button Grid.Row="4" Content="Load More Items" Icon="{ui:SymbolIcon Symbol=ArrowDown24}" Appearance="Primary" HorizontalAlignment="Center" Margin="0,0,0,32" Padding="24,12" FontSize="14" Command="{Binding LoadMoreCommand}" Visibility="{Binding CanLoadMore, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                
            </Grid>
        </ScrollViewer>

        <!-- Full-Screen Specifications Modal Overlay (100% Window Coverage) -->
        <Grid Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="1000">
            <Grid.Background>
                <SolidColorBrush Color="#90000000"/>
            </Grid.Background>
            
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="980" MaxHeight="840" Margin="24">
                <!-- Separate layer for DropShadow to prevent ClearType disabling on child text -->
                <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" Opacity="0.5" ShadowDepth="0" Color="#000000"/>
                    </Border.Effect>
                </Border>
                
                <!-- Main Content Layer -->
                <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="14" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Border Grid.Row="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="24,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#143B82F6" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="20" Foreground="#3B82F6"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource SelectableText}" Text="Product Master &amp; Rate Sheet" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.Barcode, Mode=OneWay, StringFormat='Item SKU Barcode: {0}', TargetNullValue='No Barcode Assigned'}" FontSize="14" FontWeight="SemiBold" Foreground="#3B82F6" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Symbol=Dismiss24}" Appearance="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Command="{Binding CloseDetailsCommand}" Padding="8"/>
                        </Grid>
                    </Border>

                    <!-- Modal Body (Independent Scrollable Content) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28">
                            <!-- Top Specs Overview -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Hardware Asset Badge / Image Placeholder -->
                                <Border Grid.Column="0" Height="160" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="12" VerticalAlignment="Top" Margin="0,0,24,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Width="56" Height="56" CornerRadius="28" Background="#143B82F6" Margin="0,0,0,12" HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Desktop24" FontSize="30" Foreground="#3B82F6"/>
                                        </Border>
                                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.Category, Mode=OneWay, TargetNullValue='Hardware'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                                        <TextBox Style="{StaticResource SelectableText}" Text="Verified Asset" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Specifications Key-Value Table -->
                                <StackPanel Grid.Column="1">
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.Name, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.Description, Mode=OneWay, TargetNullValue='Standard showroom inventory hardware item without extra remarks.', FallbackValue='Standard showroom inventory hardware item without extra remarks.'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14" Margin="0,0,0,18" Opacity="0.9"/>

                                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="Manufacturer Brand" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.Brand, Mode=OneWay, TargetNullValue='Unassigned'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" TextAlignment="Right"/>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="Hardware Category" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.Category, Mode=OneWay, TargetNullValue='General Hardware'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" TextAlignment="Right"/>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="2" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="Primary Measurement Unit" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.Unit, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" TextAlignment="Right"/>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="3" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="Packaging Multiplier" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.PcsPerPacket, Mode=OneWay, StringFormat='{}{0} Pieces per Box/Pack', TargetNullValue='1 Piece Standard'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" TextAlignment="Right"/>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="4" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="Current On-Hand Inventory" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.Quantity, Mode=OneWay, StringFormat='{}{0} Units Available'}" Foreground="#10B981" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" TextAlignment="Right"/>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="5" Padding="0,10">
                                                <Grid>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="Reorder Alert Threshold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.AlertQuantity, Mode=OneWay, StringFormat='Alert below {0} Units'}" Foreground="#EF4444" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" TextAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Pricing Breakdown Section -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="6" Background="#1410B981" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Money24" FontSize="16" Foreground="#10B981"/>
                                </Border>
                                <TextBox Style="{StaticResource SelectableText}" Text="Tiered Rate Structure" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            
                            <Grid Margin="0,0,0,26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Regular Retail Rates Tile -->
                                <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,8,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBox Style="{StaticResource SelectableText}" Text="Regular Retail Customer" Foreground="#3B82F6" FontWeight="Bold" FontSize="15"/>
                                            <Border Background="#143B82F6" CornerRadius="4" Padding="6,2" Margin="8,-2,0,0">
                                                <TextBox Style="{DynamicResource SelectableText}" Text="Standard" FontSize="11" FontWeight="SemiBold" Foreground="#3B82F6"/>
                                            </Border>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,12">
                                            <TextBox Style="{StaticResource SelectableText}" Text="Wholesale Rate:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.DisplayWholesalePrice, Mode=OneWay, StringFormat='৳ {0:N2}'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right" FontSize="15"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <TextBox Style="{StaticResource SelectableText}" Text="Retail Sale Price:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.DisplaySellPrice, Mode=OneWay, StringFormat='৳ {0:N2}'}" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right" FontSize="18"/>
                                        </Grid>
                                        <Grid>
                                            <TextBox Style="{StaticResource SelectableText}" Text="Unit Cost / Buy Rate:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.DisplayBuyPrice, Mode=OneWay, StringFormat='৳ {0:N2}'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" TextAlignment="Right" FontSize="14"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Registered Shop Partner Rates Tile -->
                                <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="8,0,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBox Style="{StaticResource SelectableText}" Text="Registered Shop Dealer" Foreground="#F59E0B" FontWeight="Bold" FontSize="15"/>
                                            <Border Background="#14F59E0B" CornerRadius="4" Padding="6,2" Margin="8,-2,0,0">
                                                <TextBox Style="{DynamicResource SelectableText}" Text="Partner" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                            </Border>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,12">
                                            <TextBox Style="{StaticResource SelectableText}" Text="Dealer Wholesale Rate:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.DisplayShopWholesalePrice, Mode=OneWay, StringFormat='৳ {0:N2}'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right" FontSize="15"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <TextBox Style="{StaticResource SelectableText}" Text="Dealer Retail Price:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.DisplayShopSellPrice, Mode=OneWay, StringFormat='৳ {0:N2}'}" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right" FontSize="18"/>
                                        </Grid>
                                        <Grid>
                                            <TextBox Style="{StaticResource SelectableText}" Text="Unit Cost / Buy Rate:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding SelectedProduct.DisplayBuyPrice, Mode=OneWay, StringFormat='৳ {0:N2}'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" TextAlignment="Right" FontSize="14"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Lot Information & Purchase Logs -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="6" Background="#148B5CF6" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Copy24" FontSize="16" Foreground="#8B5CF6"/>
                                </Border>
                                <TextBox Style="{StaticResource SelectableText}" Text="Purchase Lot History &amp; Incoming Batches" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SelectableText}" Grid.Column="0" Text="LOT IDENTIFIER / INVOICE REF" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Bold" FontSize="12"/>
                                            <TextBox Style="{StaticResource SelectableText}" Grid.Column="1" Text="QUANTITY ADDED" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12"/>
                                            <TextBox Style="{StaticResource SelectableText}" Grid.Column="2" Text="UNIT BUY COST" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                    
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedProduct.DisplayLots}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Box16" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                                                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding LotNumber, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="14"/>
                                                    </StackPanel>
                                                    <TextBox Style="{StaticResource SelectableText}" Grid.Column="1" Text="{Binding Quantity, Mode=OneWay, StringFormat='{}{0} Units'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" FontSize="14"/>
                                                    <TextBox Style="{StaticResource SelectableText}" Grid.Column="2" Text="{Binding BuyPrice, Mode=OneWay, StringFormat='৳ {0:N2}'}" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right" FontSize="15"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer (Permanently Docked at Bottom) -->
                    <Border Grid.Row="2" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="24,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Email Spec &amp; Rates to Admins" Appearance="Primary" Padding="18,9" Margin="0,0,12,0" Icon="{ui:SymbolIcon Symbol=Send24}" Command="{Binding SendToAdminsCommand}" ToolTip="Send this item sheet to shop supervisors via configured email system"/>
                            <ui:Button Content="Close Window" Appearance="Secondary" Padding="18,9" Command="{Binding CloseDetailsCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>



