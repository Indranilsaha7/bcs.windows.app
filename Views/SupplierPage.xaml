<Page x:Class="BarodaPOS.Views.SupplierPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:BarodaPOS.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="SupplierPage">
      
    <Page.DataContext>
        <vm:SupplierViewModel />
    </Page.DataContext>

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Supplier List" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Stats Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Purchased -->
            <ui:Card Grid.Column="0" Margin="0,0,8,0" BorderBrush="#0d6efd" BorderThickness="4,1,1,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Total Purchased" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                        <TextBlock Text="{Binding TotalPurchasedOverall, StringFormat={}{0:N2} BDT}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="50" Height="50" CornerRadius="25" Background="#cfe2ff">
                        <Path Fill="#0d6efd" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4z" />
                    </Border>
                </Grid>
            </ui:Card>

            <!-- Total Due -->
            <ui:Card Grid.Column="1" Margin="8,0,8,0" BorderBrush="#dc3545" BorderThickness="4,1,1,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Total Due" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                        <TextBlock Text="{Binding TotalDueOverall, StringFormat={}{0:N2} BDT}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="50" Height="50" CornerRadius="25" Background="#f8d7da">
                        <Path Fill="#dc3545" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M11 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8m5-4a5 5 0 1 1-10 0 5 5 0 0 1 10 0 M9.438 11.944c.047.596.518 1.06 1.363 1.116v.44h.375v-.443c.875-.061 1.386-.529 1.386-1.207 0-.618-.39-.936-1.09-1.1l-.296-.07v-1.2c.376.043.614.248.671.532h.658c-.047-.575-.54-1.024-1.329-1.073V8.5h-.375v.45c-.747.073-1.255.522-1.255 1.158 0 .562.378.92 1.007 1.066l.248.061v1.272c-.384-.058-.639-.27-.696-.563h-.669zm1.36-1.354c-.369-.085-.569-.26-.569-.522 0-.294.216-.514.572-.578v1.1h-.003zm.432.746c.449.104.655.272.655.569 0 .339-.257.571-.709.614v-1.195l.054.012z M1 0a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h4.083c.058-.344.145-.678.258-1H3a2 2 0 0 0-2-2V3a2 2 0 0 0 2-2h10a2 2 0 0 0 2 2v3.528c.38.34.717.728 1 1.154V1a1 1 0 0 0-1-1z M9.998 5.083 10 5a2 2 0 1 0-3.132 1.65 6 6 0 0 1 3.13-1.567" />
                    </Border>
                </Grid>
            </ui:Card>

            <!-- Total Return -->
            <ui:Card Grid.Column="2" Margin="8,0,0,0" BorderBrush="#ffc107" BorderThickness="4,1,1,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Total Return" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                        <TextBlock Text="{Binding TotalReturnedOverall, StringFormat={}{0:N2} BDT}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="50" Height="50" CornerRadius="25" Background="#fff3cd">
                        <Path Fill="#ffc107" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466" />
                    </Border>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- Search -->
        <ui:TextBox Grid.Row="2" 
                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                    PlaceholderText="Search by ID, proprietor, shop name, phone, or email..." 
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    Margin="0,0,0,24" 
                    Width="800" 
                    Height="45"
                    FontSize="16"
                    HorizontalAlignment="Center"/>

        <!-- Grid -->
        <Border Grid.Row="3" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Card Header -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                    <Grid>
                        <TextBlock Text="All Suppliers" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                        <ui:ToggleSwitch Content="Show Due Only" HorizontalAlignment="Right" IsChecked="{Binding ShowDueOnly, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>
                
                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding Suppliers}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          RowHeight="40"
                          Margin="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Supplier ID" Binding="{Binding Id}" Width="Auto"/>
                    <DataGridTextColumn Header="Proprietor Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Shop Name" Binding="{Binding ShopName}" Width="*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="150"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                    <DataGridTemplateColumn Header="Action" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Details" Appearance="Success" Margin="0,0,8,0"
                                               Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                    <ui:Button Content="Edit" Appearance="Caution" Margin="0,0,8,0"
                                               Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                    <ui:Button Content="Delete" Appearance="Danger"
                                               Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:ProgressRing IsIndeterminate="True" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Add/Edit Modal -->
        <Grid Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:Card Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding ModalTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="Proprietor Name" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding CurrentSupplier.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Shop Name" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding CurrentSupplier.ShopName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Phone" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding CurrentSupplier.Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Email (Optional)" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding CurrentSupplier.Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Address" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CurrentSupplier.Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,24"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,8,0" Click="CloseModal_Click"/>
                        <ui:Button Content="Save" Appearance="Primary" Command="{Binding SaveSupplierCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </Grid>
        
    </Grid>
</Page>
