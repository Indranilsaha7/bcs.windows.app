<Page x:Class="BarodaPOS.Views.SettingsMaintenancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="System Maintenance">
    <ScrollViewer Padding="24">
        <StackPanel x:Name="SectionMaintenance" MaxWidth="1000" HorizontalAlignment="Left" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ui:SymbolIcon Symbol="Wrench24" FontSize="24" Margin="0,0,12,0"/>
                <TextBox Style="{DynamicResource SelectableText}" Text="System Maintenance" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" IsReadOnly="True" />
            </StackPanel>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=FolderZip24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Export Full Database" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Download a complete JSON snapshot for offline fallback" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Export JSON" Appearance="Primary" Click="ExportDb_Click" Width="120"/>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Delete24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Clean System RAM" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Release unused memory back to the OS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Optimize" Appearance="Secondary" Click="CleanRam_Click" Width="120"/>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Box24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Database Connection" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Ping Cloud server to ensure connectivity" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Diagnostics" Appearance="Secondary" Click="CheckDb_Click" Width="120"/>
            </ui:CardControl>

            <TextBox Style="{DynamicResource SelectableText}" x:Name="StatusMessageText" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" IsReadOnly="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
