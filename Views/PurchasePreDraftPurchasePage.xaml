<Page x:Class="BarodaPOS.Views.PurchasePreDraftPurchasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:viewmodels="clr-namespace:BarodaPOS.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="PurchasePreDraftPurchasePage">

    <Page.DataContext>
        <viewmodels:PurchasePreDraftPurchaseViewModel />
    </Page.DataContext>

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Padding="32,28,40,32" Background="Transparent">
            <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">
                
                <!-- Page Header -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" Background="#1AEAB308" Margin="0,0,16,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="28" Foreground="#EAB308"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Style="{DynamicResource SelectableText}" Text="Scan Pre-Purchase Draft" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBox Style="{DynamicResource SelectableText}" Text="Scan a QR code or upload a QR image to load a draft and finalize the purchase." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left Column: Load Draft & Edit -->
                    <StackPanel Grid.Column="0">
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,24" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBox Style="{DynamicResource SelectableText}" Text="Load Draft" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16"/>
                                
                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBox Style="{DynamicResource SelectableText}" Text="Scan QR Code (Draft ID)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                        <ui:TextBox Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}" Icon="{ui:SymbolIcon Symbol=BarcodeScanner24}" Padding="10">
                                            <ui:TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding LoadDraftCommand}"/>
                                            </ui:TextBox.InputBindings>
                                        </ui:TextBox>
                                    </StackPanel>
                                    
                                    <ui:Button Grid.Column="2" Content="Load" Appearance="Primary" Command="{Binding LoadDraftCommand}" Icon="{ui:SymbolIcon Symbol=Search24}" Margin="0,25,0,0" Padding="20,10" VerticalAlignment="Top"/>
                                    
                                    <ui:Button Grid.Column="4" Content="Upload QR Image" Appearance="Secondary" Command="{Binding UploadImageCommand}" Icon="{ui:SymbolIcon Symbol=Image24}" Margin="0,25,0,0" Padding="20,10" VerticalAlignment="Top" ToolTip="Upload an image containing the QR code"/>
                                </Grid>
                                
                                <Border Height="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,24"/>
                                
                                <TextBox Style="{DynamicResource SelectableText}" Text="Draft Items" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16"/>

                                <DataGrid ItemsSource="{Binding DraftItems}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="45" Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Item Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Supplier" Binding="{Binding TargetSupplierName}" Width="1.5*" IsReadOnly="True"/>
                                        
                                        <DataGridTemplateColumn Header="Cost" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="4,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        
                                        <DataGridTemplateColumn Header="Qty" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="4,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="100" IsReadOnly="True" FontWeight="SemiBold"/>
                                        
                                        <DataGridTemplateColumn Header="Remove" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}" Appearance="Danger" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Finalize -->
                    <StackPanel Grid.Column="2">
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,24" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBox Style="{DynamicResource SelectableText}" Text="Finalize Purchase" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16"/>
                                <Border Height="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,16"/>
                                
                                <TextBox Style="{DynamicResource SelectableText}" Text="Loaded Draft ID" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{DynamicResource SelectableText}" Text="{Binding LoadedDraftId}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16"/>

                                <TextBox Style="{DynamicResource SelectableText}" Text="Global Default Supplier" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{DynamicResource SelectableText}" Text="{Binding DefaultSupplierName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,24"/>

                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{DynamicResource SelectableText}" Grid.Column="0" Text="Total Amount:" FontSize="22" FontWeight="Bold"/>
                                    <TextBox Style="{DynamicResource SelectableText}" Grid.Column="1" Text="{Binding TotalAmount, StringFormat={}{0:N2} BDT}" FontSize="24" FontWeight="Black" Foreground="#EAB308" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <TextBox Style="{DynamicResource SelectableText}" Text="Paid Amount *" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                <ui:TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,16" Icon="{ui:SymbolIcon Symbol=Money24}"/>

                                <ui:Button Content="Complete Purchase" Command="{Binding CompletePurchaseCommand}" Icon="{ui:SymbolIcon Symbol=Checkmark24}" Appearance="Primary" Padding="16,12" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Stretch" ToolTip="Convert this draft into a completed Purchase"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="60" Height="60" Foreground="#EAB308"/>
                <TextBlock Text="Processing..." Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
