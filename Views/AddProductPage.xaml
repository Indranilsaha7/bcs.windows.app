                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Wholesale Rate (Shop / Dealer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
