                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Liter Pricing -->
                        <StackPanel Visibility="{Binding IsLiterPriceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Tier: Liter -->
                            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,20" Background="#05FFFFFF">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#1A10B981" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Money24" FontSize="18" Foreground="#10B981"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Liter Pricing" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Set rates per complete liter volume" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Buy Price (Cost / Liter) *" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding BuyPriceLiter}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Wholesale Rate (Normal Customer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding WholesalePriceLiterNormal}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Wholesale Rate (Shop / Dealer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding WholesalePriceLiterShop}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Retail Sale Rate (Normal Customer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding SellPriceLiterNormal}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Retail Sale Rate (Shop / Dealer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding SellPriceLiterShop}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Tier: ML Pricing -->
                            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,0" Background="#05FFFFFF">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#1AF59E0B" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Money24" FontSize="18" Foreground="#F59E0B"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Milliliter (ML) Pricing (Optional Sub-Unit)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Set fractional volume rates per milliliter" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Buy Price (Cost / ML)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding BuyPriceMl}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Wholesale Rate (Normal Customer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding WholesalePriceMlNormal}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Wholesale Rate (Shop / Dealer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding WholesalePriceMlShop}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Retail Sale Rate (Normal Customer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding SellPriceMlNormal}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Retail Sale Rate (Shop / Dealer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding SellPriceMlShop}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Packet Pricing -->
                        <StackPanel Visibility="{Binding IsPacketPriceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Tier: Packet -->
                            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,20" Background="#05FFFFFF">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#1A10B981" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Money24" FontSize="18" Foreground="#10B981"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Packet Pricing" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Set rates per complete packet unit" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Buy Price (Cost / Packet) *" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding BuyPricePacket}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Wholesale Rate (Normal Customer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding WholesalePricePacketNormal}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Wholesale Rate (Shop / Dealer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding WholesalePricePacketShop}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Retail Sale Rate (Normal Customer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding SellPricePacketNormal}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Retail Sale Rate (Shop / Dealer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding SellPricePacketShop}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Tier: PCS inside Packet -->
                            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,0" Background="#05FFFFFF">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#1A8B5CF6" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Money24" FontSize="18" Foreground="#8B5CF6"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Individual Piece (PCS) Pricing (Optional Sub-Unit)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Set individual piece rates when selling broken packet contents" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Buy Price (Cost / PCS)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding BuyPricePacketPcs}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Wholesale Rate (Normal Customer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding WholesalePricePacketPcsNormal}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Wholesale Rate (Shop / Dealer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding WholesalePricePacketPcsShop}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Retail Sale Rate (Normal Customer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding SellPricePacketPcsNormal}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Retail Sale Rate (Shop / Dealer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding SellPricePacketPcsShop}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Standard PCS Pricing (Fallback / Default) -->
                        <StackPanel Visibility="{Binding IsStandardPriceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,0" Background="#05FFFFFF">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#1A10B981" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Money24" FontSize="18" Foreground="#10B981"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Standard Piece (PCS) Pricing" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Set standard acquisition cost and wholesale/retail selling rates per piece" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Buy Price (Cost / Pcs) *" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding BuyPrice}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Wholesale Rate (Normal Customer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding WholesalePriceNormal}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Wholesale Rate (Shop / Dealer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding WholesalePriceShop}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Retail Sale Rate (Normal Customer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding SellPriceNormal}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBox Style="{DynamicResource SelectableText}" Text="Retail Sale Rate (Shop / Dealer)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBox Text="{Binding SellPriceShop}" Icon="{ui:SymbolIcon Symbol=Money24}" Padding="10,10"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Additional Information Card -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12" Padding="28" Margin="0,0,0,28" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#1AF59E0B" Margin="0,0,16,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DocumentEdit24" FontSize="22" Foreground="#F59E0B"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBox Style="{DynamicResource SelectableText}" Text="Additional Information" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBox Style="{DynamicResource SelectableText}" Text="Optional detailed descriptions, internal storage notes, and product specifications" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <Border Height="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,24"/>

                        <StackPanel Margin="0,0,0,0">
                            <TextBox Style="{DynamicResource SelectableText}" Text="Product Description &amp; Notes" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="110" Padding="12" FontSize="14" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Actions Footer Card -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,40" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBox Style="{DynamicResource SelectableText}" Text="Ready to save product details?" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Style="{DynamicResource SelectableText}" Text="Verify pricing tiers, category assignment, and barcodes before saving to inventory." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="{Binding SaveButtonText}" Command="{Binding SaveProductAsyncCommand}" Icon="{ui:SymbolIcon Symbol=Save24}" Appearance="Primary" Padding="32,12" FontSize="15" FontWeight="SemiBold" Cursor="Hand"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>



