<Page x:Class="BarodaPOS.Views.SettingsSystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="System Information">
    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="System Environment Details" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Desktop24}">
                <ui:CardControl.Header>
                    <TextBlock Text="Operating System" FontWeight="SemiBold" FontSize="14" />
                </ui:CardControl.Header>
                <TextBlock x:Name="OsVersionText" Text="Loading..." Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Code24}">
                <ui:CardControl.Header>
                    <TextBlock Text="Application Framework" FontWeight="SemiBold" FontSize="14" />
                </ui:CardControl.Header>
                <TextBlock x:Name="DotNetVersionText" Text="Loading..." Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=DataBarHorizontal24}">
                <ui:CardControl.Header>
                    <TextBlock Text="App Memory Usage" FontWeight="SemiBold" FontSize="14" />
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MemoryUsageText" Text="Loading..." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <ui:Button Content="Refresh" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Appearance="Secondary" Click="RefreshStats_Click"/>
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="Activation Tools" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Key24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Windows 11 Pro Upgrade &amp; Activation" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Runs upgrade keys and KMS activation automatically." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Activate Windows" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Play24}" Click="ActivateWindows_Click" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Document24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Office / Universal Activation (MAS)" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Launches Microsoft Activation Scripts via PowerShell." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Run MAS" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Play24}" Click="ActivateOffice_Click" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
