<Page x:Class="BarodaPOS.Views.SettingsSidebarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Sidebar Settings">
    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Sidebar Configuration" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Desktop24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Sidebar Position" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Choose where the sidebar docks on the screen" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="SidebarPositionCombo" Width="150" SelectedIndex="0">
                    <ComboBoxItem Content="Left" />
                    <ComboBoxItem Content="Top" />
                    <ComboBoxItem Content="Bottom" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Eye24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Open on Hover" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Automatically expand the sidebar when hovering over it" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="OpenOnHoverToggle" IsChecked="True" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Settings24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Auto Close" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Automatically collapse the sidebar when mouse leaves" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutoCloseToggle" IsChecked="False" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=List24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Auto Open" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Keep the sidebar fully expanded by default" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutoOpenToggle" IsChecked="True" />
            </ui:CardControl>

            <ui:Button Content="Save Settings" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" HorizontalAlignment="Right" Margin="0,16,0,0" Click="SaveSettings_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
