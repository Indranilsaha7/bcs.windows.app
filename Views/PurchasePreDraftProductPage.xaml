<Page x:Class="BarodaPOS.Views.PurchasePreDraftProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:viewmodels="clr-namespace:BarodaPOS.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="PurchasePreDraftProductPage">

    <Page.DataContext>
        <viewmodels:PurchasePreDraftProductViewModel />
    </Page.DataContext>

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Padding="32,28,40,32" Background="Transparent">
            <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">
                
                <!-- Page Header -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" Background="#1AEAB308" Margin="0,0,16,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="28" Foreground="#EAB308"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Style="{DynamicResource SelectableText}" Text="Draft Pre-Purchase" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBox Style="{DynamicResource SelectableText}" Text="Create a list of items to buy, print with a QR Code, and scan later upon delivery." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left Column: Add Items & Cart -->
                    <StackPanel Grid.Column="0">
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,24" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBox Style="{DynamicResource SelectableText}" Text="Add Items to Draft" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Product Search -->
                                    <StackPanel Grid.Column="0">
                                        <TextBox Style="{DynamicResource SelectableText}" Text="Search Product *" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <ui:TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search by name or barcode..." Icon="{ui:SymbolIcon Symbol=Search24}" Padding="10"/>
                                            <Popup IsOpen="{Binding IsProductSearchResultsVisible}" PlacementTarget="{Binding ElementName=SearchBox}" StaysOpen="False" MaxHeight="300" Width="{Binding ActualWidth, ElementName=SearchBox}">
                                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                                    <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding FilteredProducts}" Background="Transparent" BorderThickness="0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Command="{Binding DataContext.SelectProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,4" Cursor="Hand">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                                            <TextBlock Text="{Binding Barcode, StringFormat='Barcode: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Cost -->
                                    <StackPanel Grid.Column="2">
                                        <TextBox Style="{DynamicResource SelectableText}" Text="Est. Cost *" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                        <ui:TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" Padding="10"/>
                                    </StackPanel>

                                    <!-- Quantity -->
                                    <StackPanel Grid.Column="4">
                                        <TextBox Style="{DynamicResource SelectableText}" Text="Qty *" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                        <ui:TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Padding="10"/>
                                    </StackPanel>

                                    <!-- Add Button -->
                                    <ui:Button Grid.Column="6" Content="Add" Appearance="Primary" Command="{Binding AddToCartCommand}" Icon="{ui:SymbolIcon Symbol=Add24}" Margin="0,25,0,0" Padding="20,10" VerticalAlignment="Top"/>
                                </Grid>
                                
                                <Border Height="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,24,0,24"/>
                                
                                <DataGrid ItemsSource="{Binding Cart}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="45" Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Item Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                                        
                                        <!-- Per Product Supplier Selection -->
                                        <DataGridTemplateColumn Header="Supplier" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.Suppliers, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                              SelectedValue="{Binding TargetSupplierId, UpdateSourceTrigger=PropertyChanged}" 
                                                              DisplayMemberPath="ShopName" SelectedValuePath="Id" 
                                                              Padding="6" Margin="4,0" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Est. Cost" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="4,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        
                                        <DataGridTemplateColumn Header="Qty" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="4,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="100" IsReadOnly="True" FontWeight="SemiBold"/>
                                        
                                        <DataGridTemplateColumn Header="Remove" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}" Appearance="Danger" Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Save -->
                    <StackPanel Grid.Column="2">
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,24" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBox Style="{DynamicResource SelectableText}" Text="Draft Details" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16"/>
                                <Border Height="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,16"/>
                                
                                <TextBox Style="{DynamicResource SelectableText}" Text="Default Supplier (Applies to newly added items)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="ShopName" HorizontalAlignment="Stretch" Padding="12,10" FontSize="14" Margin="0,0,0,24"/>

                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{DynamicResource SelectableText}" Grid.Column="0" Text="Est. Total:" FontSize="22" FontWeight="Bold"/>
                                    <TextBox Style="{DynamicResource SelectableText}" Grid.Column="1" Text="{Binding TotalEstimatedAmount, StringFormat={}{0:N2} BDT}" FontSize="24" FontWeight="Black" Foreground="#EAB308" HorizontalAlignment="Right"/>
                                </Grid>

                                <ui:Button Content="Save Draft &amp; Print Receipt" Command="{Binding SaveAndPrintReceiptCommand}" Icon="{ui:SymbolIcon Symbol=Print24}" Appearance="Primary" Padding="16,12" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Stretch" Margin="0,0,0,12" ToolTip="Prints a thermal receipt with QR code"/>
                                <ui:Button Content="Save Draft &amp; Export PDF" Command="{Binding SaveAndExportPdfCommand}" Icon="{ui:SymbolIcon Symbol=DocumentPdf24}" Appearance="Secondary" Padding="16,12" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Stretch" ToolTip="Exports an A4 PDF with QR code"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:ProgressRing IsIndeterminate="True" Width="60" Height="60"/>
        </Grid>
    </Grid>
</Page>
