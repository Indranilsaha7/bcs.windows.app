<ui:FluentWindow x:Class="BarodaPOS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:BarodaPOS.Views"
        mc:Ignorable="d"
        Title="Baroda Computer and Sales POS" Height="720" Width="1280"
        Icon="pack://application:,,,/al.png"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Topbar -->
        <Grid x:Name="TopBarGrid" Grid.Row="0" Panel.ZIndex="101">
            <ui:TitleBar x:Name="AppTitleBar" Title="Baroda Computer and Sales" Icon="{ui:SymbolIcon Symbol=Box24}" Background="Transparent">
                <ui:TitleBar.TrailingContent>
                    <StackPanel x:Name="AppTitleBarHeader" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ui:Button x:Name="TaskBtn" Icon="{ui:SymbolIcon Symbol=CheckmarkSquare24}" Content="Tasks" Appearance="Secondary" Click="TaskBtn_Click" Margin="0,0,8,0" />
                        <ui:Button x:Name="CalendarBtn" Icon="{ui:SymbolIcon Symbol=Calendar24}" Content="Calendar" Appearance="Secondary" Click="CalendarBtn_Click" Margin="0,0,8,0" />
                        <ui:Button x:Name="RefreshBtn" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Content="Refresh" Appearance="Primary" Click="RefreshBtn_Click" Margin="0,0,8,0" />
                        <ui:Button x:Name="LogoutBtn" Icon="{ui:SymbolIcon Symbol=SignOut24}" Content="Logout" Appearance="Danger" Click="LogoutBtn_Click" />
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>
        </Grid>

        <!-- Sidebar and Content -->
        <ui:NavigationView Grid.Row="1" x:Name="RootNavigation" OpenPaneLength="250"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                           TransitionDuration="300"
                           Transition="SlideBottom">

            <ui:NavigationView.AutoSuggestBox>
                <ui:AutoSuggestBox PlaceholderText="Search pages..." Icon="{ui:SymbolIcon Symbol=Search24}" />
            </ui:NavigationView.AutoSuggestBox>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard" TargetPageType="{x:Type local:DashboardPage}" Icon="{ui:SymbolIcon Symbol=Home24}" />
                
                <!-- Products with Sub-Links -->
                <ui:NavigationViewItem Content="Products" Icon="{ui:SymbolIcon Symbol=Box24}">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="All Products" TargetPageType="{x:Type local:ProductPage}" Icon="{ui:SymbolIcon Symbol=List24}" />
                        <ui:NavigationViewItem Content="Add Product" TargetPageType="{x:Type local:AddProductPage}" Icon="{ui:SymbolIcon Symbol=Add24}" />
                        <ui:NavigationViewItem Content="Import Products" TargetPageType="{x:Type local:ImportProductPage}" Icon="{ui:SymbolIcon Symbol=ArrowUpload24}" />
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <!-- Sales with Sub-Links -->
                <ui:NavigationViewItem Content="Sales" Icon="{ui:SymbolIcon Symbol=Money24}">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="New Sale" TargetPageType="{x:Type local:SalePage}" Icon="{ui:SymbolIcon Symbol=Cart24}" />
                        <ui:NavigationViewItem Content="Add Sale History" TargetPageType="{x:Type local:AddSaleHistoryPage}" Icon="{ui:SymbolIcon Symbol=History24}" />
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <!-- Purchases with Sub-Links -->
                <ui:NavigationViewItem Content="Purchases" Icon="{ui:SymbolIcon Symbol=Receipt24}">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="Draft Pre-Purchase" TargetPageType="{x:Type local:PrePurchasePage}" Icon="{ui:SymbolIcon Symbol=ShoppingBag24}" />
                        <ui:NavigationViewItem Content="Fast Purchase Scan" TargetPageType="{x:Type local:FastPurchasePage}" Icon="{ui:SymbolIcon Symbol=BarcodeScanner24}" />
                        <ui:NavigationViewItem Content="Detailed Purchase" TargetPageType="{x:Type local:PurchasePage}" Icon="{ui:SymbolIcon Symbol=Add24}" />
                        <ui:NavigationViewItem Content="Purchase List" TargetPageType="{x:Type local:PurchaseHistoryPage}" Icon="{ui:SymbolIcon Symbol=History24}" />
                        <ui:NavigationViewItem Content="Purchase Return" TargetPageType="{x:Type local:PurchaseReturnPage}" Icon="{ui:SymbolIcon Symbol=ArrowUndo24}" />
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <!-- People with Sub-Links -->
                <ui:NavigationViewItem Content="People" Icon="{ui:SymbolIcon Symbol=People24}">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="Customers" TargetPageType="{x:Type local:PeoplePage}" Icon="{ui:SymbolIcon Symbol=Person24}" />
                        <ui:NavigationViewItem Content="Suppliers" TargetPageType="{x:Type local:SupplierPage}" Icon="{ui:SymbolIcon Symbol=Building24}" />
                        <ui:NavigationViewItem Content="Add Supplier" TargetPageType="{x:Type local:AddSupplierPage}" Icon="{ui:SymbolIcon Symbol=PersonAdd24}"/>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Reports" TargetPageType="{x:Type local:ReportPage}" Icon="{ui:SymbolIcon Symbol=DataBarHorizontal24}" />
                <ui:NavigationViewItem Content="Network Sync" TargetPageType="{x:Type local:SyncDashboardPage}" Icon="{ui:SymbolIcon Symbol=Cloud24}" />
            </ui:NavigationView.MenuItems>
            
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type local:SettingsPage}" Icon="{ui:SymbolIcon Symbol=Settings24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="8">
            <TextBox Style="{DynamicResource SelectableText}" Text="Made with ❤️ in Bangladesh | Version: 1.0.0 | Developed by Indranil Saha and BCSdeveloper | Powered by Google Cloud and Firebase" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="15"/>
        </Border>

        <!-- Login Overlay -->
        <Frame x:Name="LoginFrame" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100" NavigationUIVisibility="Hidden" Background="{DynamicResource ApplicationBackgroundBrush}" />
    </Grid>
</ui:FluentWindow>



