<Window x:Class="BarodaPOS.Views.SaleDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Sale Details" Height="600" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16,24,16,24">
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="12" 

                    Padding="24"
                    MaxWidth="500">
                <StackPanel>
                    
                    <!-- Header Icon & Title -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#1A10B981" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Receipt24" FontSize="32" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SALE RECEIPT" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding Id}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,20"/>

                    <!-- Details Section -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="DATE" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DateValue, StringFormat={}{0:MMM dd, yyyy HH:mm}}" FontSize="14" FontWeight="Medium" Margin="0,2,0,12"/>
                            
                            <TextBlock Text="SOLD BY" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SoldBy[name]}" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="CUSTOMER" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Customer[name]}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" Margin="0,2,0,12"/>

                            <TextBlock Text="MODE" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SaleMode}" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,16"/>

                    <!-- Items Table Header -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ITEM" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="QTY" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="TOTAL" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
                    </Grid>

                    <!-- Items List -->
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="14" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding SaleType}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="14" VerticalAlignment="Top" TextAlignment="Center" Margin="0,1,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat=N2}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Top" TextAlignment="Right" Margin="0,1,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,8,0,16"/>

                    <!-- Totals Section -->
                    <StackPanel>
                        <!-- Format Helper Style for Totals -->
                        <StackPanel.Resources>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="0,4,0,0"/>
                            </Style>
                            <Style TargetType="TextBlock" x:Key="TotalLabel">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="TextBlock" x:Key="TotalValue">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </StackPanel.Resources>

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Subtotal" Style="{StaticResource TotalLabel}"/>
                            <TextBlock Text="{Binding Subtotal, StringFormat=N2}" Style="{StaticResource TotalValue}"/>
                        </Grid>
                        
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Discount" Style="{StaticResource TotalLabel}"/>
                            <TextBlock Text="{Binding Discount, StringFormat=-{0:N2}}" Style="{StaticResource TotalValue}" Foreground="#EF4444"/>
                        </Grid>
                        
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Tax" Style="{StaticResource TotalLabel}"/>
                            <TextBlock Text="{Binding Tax, StringFormat=+{0:N2}}" Style="{StaticResource TotalValue}"/>
                        </Grid>
                        
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Shipping" Style="{StaticResource TotalLabel}"/>
                            <TextBlock Text="{Binding Shipping, StringFormat=+{0:N2}}" Style="{StaticResource TotalValue}"/>
                        </Grid>
                        
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Carry Charge" Style="{StaticResource TotalLabel}"/>
                            <TextBlock Text="{Binding Carry, StringFormat=+{0:N2}}" Style="{StaticResource TotalValue}"/>
                        </Grid>
                        
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Maintenance" Style="{StaticResource TotalLabel}"/>
                            <TextBlock Text="{Binding Maintenance, StringFormat=+{0:N2}}" Style="{StaticResource TotalValue}"/>
                        </Grid>
                        
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Points Used" Style="{StaticResource TotalLabel}"/>
                            <TextBlock Text="{Binding PointsUsed, StringFormat=-{0:N2}}" Style="{StaticResource TotalValue}" Foreground="#EF4444"/>
                        </Grid>
                        
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Points Earned" Style="{StaticResource TotalLabel}"/>
                            <TextBlock Text="{Binding PointsEarned, StringFormat=+{0:N2}}" Style="{StaticResource TotalValue}" Foreground="#10B981"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,16"/>

                        <!-- Grand Total -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Grand Total" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding PaymentMethod, StringFormat='Paid via {0}'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat=BDT {0:N2}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Paid / Due -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Amount Paid" Style="{StaticResource TotalLabel}"/>
                            <TextBlock Text="{Binding PaidAmount, StringFormat=N2}" Style="{StaticResource TotalValue}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Amount Due" Style="{StaticResource TotalLabel}"/>
                            <TextBlock Text="{Binding DueAmount, StringFormat=N2}" Style="{StaticResource TotalValue}" FontWeight="Bold" Foreground="#EF4444"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0" Padding="16">
            <Grid>
                <ui:Button Content="Close" Click="CloseBtn_Click" HorizontalAlignment="Left" Padding="24,8"/>
                <ui:Button Content="Print Receipt" Click="PrintReceiptBtn_Click" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Print24}" HorizontalAlignment="Right" Padding="24,8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
