<Page x:Class="BarodaPOS.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:BarodaPOS.Views"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1280"
      Title="LoginPage"
      KeyDown="Page_KeyDown"
      Background="#02040A">

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="WallpaperImage" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.5" >
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    
                    <DoubleAnimation Storyboard.TargetName="MainGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8" BeginTime="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetName="MainTranslate" Storyboard.TargetProperty="Y" From="40" To="0" Duration="0:0:0.8" BeginTime="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Grid>
        <!-- Background Wallpaper -->
        <Image x:Name="WallpaperImage" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Source>
                <BitmapImage UriSource="pack://application:,,,/bg-walpaper.png" DecodePixelWidth="1920" CacheOption="OnLoad"/>
            </Image.Source>
        </Image>
        
        <!-- Deep Cinematic Overlay for Depth & Clarity -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#99020611" Offset="0"/> <!-- 60% opacity -->
                    <GradientStop Color="#B3010308" Offset="1"/> <!-- 70% opacity -->
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Ambient Glow behind the card -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="700" Height="400" Opacity="0.15" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#38BDF8" Offset="0"/>
                    <GradientStop Color="#4F46E5" Offset="0.5"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Form Container -->
        <Grid x:Name="MainGrid" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="MainTranslate" Y="40"/>
            </Grid.RenderTransform>

            <!-- Centered Premium Glass Card -->
            <Border Width="960" Height="580" CornerRadius="32" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#C80F172A" Offset="0"/>
                        <GradientStop Color="#E6020617" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" Color="#000000" Opacity="0.6" Direction="270" ShadowDepth="15"/>
                </Border.Effect>

                <!-- Glass Ring Border -->
                <Border CornerRadius="32" BorderThickness="1.5">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#50FFFFFF" Offset="0"/>
                            <GradientStop Color="#10FFFFFF" Offset="0.2"/>
                            <GradientStop Color="#05FFFFFF" Offset="0.8"/>
                            <GradientStop Color="#30FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="440" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Pane: Brand Identity Showcase -->
                        <Border Grid.Column="0" CornerRadius="31,0,0,31" BorderThickness="0,0,1,0" BorderBrush="#1AFFFFFF">
                            <Border.Background>
                                <!-- Subtle gradient overlay for the left panel -->
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#10FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid Margin="48,56,48,40">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                    <Border Width="100" Height="100" CornerRadius="26" HorizontalAlignment="Left" Margin="0,0,0,32" BorderThickness="1.5" BorderBrush="#40FFFFFF">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#352563EB" Offset="0"/>
                                                <GradientStop Color="#181E1B4B" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" Color="#38BDF8" Opacity="0.3" ShadowDepth="0"/>
                                        </Border.Effect>
                                        <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="46" Foreground="#38BDF8"/>
                                    </Border>

                                    <TextBlock Text="Baroda Computer &amp; Sales" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="36"/>
                                    <TextBlock Text="PRO RETAIL &amp; INVENTORY POS" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" />

                                    <Border Height="1" Margin="0,32,0,0" HorizontalAlignment="Stretch">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#5038BDF8" Offset="0"/>
                                                <GradientStop Color="#0038BDF8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#15FFFFFF" CornerRadius="16" Padding="14,8">
                                    <TextBlock Text="Made with ❤️ in Bangladesh" FontSize="12" FontWeight="Medium" Foreground="#CBD5E1"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Right Pane: Interactive Access Console -->
                        <Border Grid.Column="1" CornerRadius="0,31,31,0">
                            <Grid>
                                <!-- Subtle top radial light highlight for internal ambiance -->
                                <Border VerticalAlignment="Top" HorizontalAlignment="Center" Height="300" Width="400" Margin="0,-80,0,0" Opacity="0.12" IsHitTestVisible="False">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="#38BDF8" Offset="0"/>
                                            <GradientStop Color="#0038BDF8" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>

                                <StackPanel Margin="56,48,56,48" VerticalAlignment="Center">
                                    <!-- Console Header -->
                                    <StackPanel Margin="0,0,0,40">
                                        <TextBlock Text="Operator Sign In" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                        <TextBlock Text="Enter your operator credentials to securely access the terminal workspace." FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="20"/>
                                    </StackPanel>

                                <StackPanel x:Name="NormalLoginContainer">
                                    <!-- Username Field -->
                                    <StackPanel Margin="0,0,0,24">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <ui:SymbolIcon Symbol="Person24" FontSize="14" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="OPERATOR USERNAME" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                                    PlaceholderText="e.g. admin" 
                                                    Padding="16,14" FontSize="15"
                                                    Background="#1AFFFFFF" Foreground="#FFFFFF" CaretBrush="#38BDF8">
                                            <ui:TextBox.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#15FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </ui:TextBox.BorderBrush>
                                        </ui:TextBox>
                                    </StackPanel>

                                    <!-- Password Field -->
                                    <StackPanel Margin="0,0,0,24">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <ui:SymbolIcon Symbol="Key24" FontSize="14" Foreground="#FBBF24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="SECURE PASSWORD" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:PasswordBox x:Name="PasswordBox" 
                                                        PlaceholderText="••••••••" 
                                                        PasswordChanged="PasswordBox_PasswordChanged" 
                                                        Padding="16,14" FontSize="15"
                                                        Background="#1AFFFFFF" Foreground="#FFFFFF" CaretBrush="#FBBF24">
                                            <ui:PasswordBox.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#15FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </ui:PasswordBox.BorderBrush>
                                        </ui:PasswordBox>
                                    </StackPanel>

                                    <!-- Access PIN Field -->
                                    <StackPanel Margin="0,0,0,40">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="14" Foreground="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ACCESS PIN (OPTIONAL)" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:PasswordBox x:Name="CodeBox" 
                                                        PlaceholderText="Additional security PIN" 
                                                        PasswordChanged="CodeBox_PasswordChanged" 
                                                        Padding="16,14" FontSize="15"
                                                        Background="#1AFFFFFF" Foreground="#FFFFFF" CaretBrush="#34D399">
                                            <ui:PasswordBox.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#15FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </ui:PasswordBox.BorderBrush>
                                        </ui:PasswordBox>
                                    </StackPanel>

                                    <!-- Premium Glow Unlock Terminal Button -->
                                    <Button Command="{Binding LoginCommand}" 
                                            HorizontalAlignment="Stretch" 
                                            Height="54" Cursor="Hand" BorderThickness="0" Background="Transparent">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" CornerRadius="27" BorderThickness="1.5">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#0284C7" Offset="0"/>
                                                            <GradientStop Color="#2563EB" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.BorderBrush>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#8038BDF8" Offset="0"/>
                                                            <GradientStop Color="#5060A5FA" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.BorderBrush>
                                                    <Grid>
                                                        <Border CornerRadius="25" BorderThickness="1" BorderBrush="#20FFFFFF" Margin="1"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="UNLOCK TERMINAL" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="20" Foreground="#FFFFFF" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#0369A1" Offset="0"/>
                                                                    <GradientStop Color="#1D4ED8" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#A038BDF8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                                                        <Setter TargetName="BtnBorder" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.98" ScaleY="0.98" CenterX="150" CenterY="27"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                                
                                <!-- Fast PIN Container -->
                                <StackPanel x:Name="FastPinContainer" Visibility="Collapsed" Margin="0,20,0,0">
                                    <TextBlock Text="Enter your Fast PIN to login as admin" FontSize="14" Foreground="#E2E8F0" TextAlignment="Center" Margin="0,0,0,24" />
                                    
                                    <ui:PasswordBox x:Name="QuickPinBox" 
                                                    PlaceholderText="Fast PIN" 
                                                    PasswordChanged="QuickPinBox_PasswordChanged" 
                                                    Padding="16,14" FontSize="20" HorizontalContentAlignment="Center"
                                                    Background="#1AFFFFFF" Foreground="#FFFFFF" CaretBrush="#34D399" Margin="0,0,0,40">
                                        <ui:PasswordBox.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#40FFFFFF" Offset="0"/>
                                                <GradientStop Color="#15FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </ui:PasswordBox.BorderBrush>
                                    </ui:PasswordBox>
                                    
                                    <TextBlock HorizontalAlignment="Center" Foreground="#94A3B8">
                                        <Hyperlink Click="SwitchUser_Click" Foreground="#94A3B8" TextDecorations="Underline">
                                            Switch User / Normal Login
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Border>
            
            <!-- Notification Popup -->
            <Border x:Name="NotificationPopup" CornerRadius="16" Padding="24,18" Margin="0,40,40,0" 
                    Visibility="Hidden" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Background="#90000000" 
                    BorderBrush="#50FFFFFF" BorderThickness="1.5" Panel.ZIndex="200">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.4" ShadowDepth="5" Color="Black"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform Y="-20"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ui:SymbolIcon x:Name="NotificationIcon" Symbol="Checkmark24" FontSize="22" Margin="0,0,14,0" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NotificationText" Text="Message" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                </StackPanel>
            </Border>
            
        </Grid>
    </Grid>
</Page>
