<Page x:Class="BarodaPOS.Views.SettingsHardwarePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Hardware Configuration">
    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Hardware Configuration" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Print24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Default Printer" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Select the printer for thermal receipts" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="PrinterComboBox" Width="200" Margin="0,0,8,0" />
                    <ui:Button Content="Save" Appearance="Primary" Click="SavePrinter_Click" Margin="0,0,8,0" />
                    <ui:Button Content="Test" Appearance="Secondary" Click="TestPrint_Click" Margin="0,0,8,0" />
                    <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}" Appearance="Danger" Click="RemovePrinter_Click" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Document24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Receipt Margin" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Extra blank space at the bottom" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="BottomMarginSlider" Width="150" Minimum="0" Maximum="200" Value="50" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ElementName=BottomMarginSlider, Path=Value, StringFormat={}{0} units}" FontWeight="SemiBold" VerticalAlignment="Center" Width="60"/>
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Settings24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Auto Printing" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Automatically print receipt after a sale" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutoPrintToggle" IsChecked="True" Checked="AutoPrintToggle_Changed" Unchecked="AutoPrintToggle_Changed" />
            </ui:CardControl>

            <TextBlock x:Name="PrinterStatusText" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="Collapsed" HorizontalAlignment="Right" />
        </StackPanel>
    </ScrollViewer>
</Page>
