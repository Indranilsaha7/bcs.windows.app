<Page x:Class="BarodaPOS.Views.SyncDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Network Sync Dashboard">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Hybrid Cloud Architecture Dashboard" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Monitors Cloud (Firebase) connection and manages Local P2P Fallback Sync." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,24">
            <ui:CardControl Margin="0,0,0,16" Icon="{ui:SymbolIcon Symbol=Cloud24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Current Operating Mode" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock x:Name="CurrentModeText" Text="Checking..." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cloud Re-Sync Queue: " VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ui:Badge x:Name="QueueBadge" Appearance="Danger" Content="0" Margin="0,0,16,0"/>
                    <ui:Button x:Name="FlushQueueButton" Content="Push to Cloud" Icon="{ui:SymbolIcon Symbol=CloudArrowUp24}" Appearance="Primary" Click="FlushQueue_Click" IsEnabled="False"/>
                </StackPanel>
            </ui:CardControl>

            <UniformGrid Columns="3">
                <ui:CardControl Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=DataBarHorizontal24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="P2P Local Status" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="StatusText" Text="Searching..." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <ui:CardControl Margin="8,0,8,0" Icon="{ui:SymbolIcon Symbol=Desktop24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Peer Node" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="PeerText" Text="None" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <ui:CardControl Margin="8,0,0,0" Icon="{ui:SymbolIcon Symbol=Database24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Master Node Status" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="MasterStatusText" Text="Calculating..." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </ui:CardControl.Header>
                </ui:CardControl>
            </UniformGrid>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="SpaceBetween" Margin="0,0,0,8">
                <TextBlock Text="Real-Time Sync Logs" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
                <ui:Button Content="Force Sync" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Appearance="Primary" Click="ForceSync_Click" HorizontalAlignment="Right"/>
            </StackPanel>
            
            <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
